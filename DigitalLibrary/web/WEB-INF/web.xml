<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    
    <display-name>Digital Library</display-name>
    
    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- Google OAuth Servlet -->
    <servlet>
        <servlet-name>GoogleAuthServlet</servlet-name>
        <servlet-class>controller.GoogleAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleAuthServlet</servlet-name>
        <url-pattern>/auth/google</url-pattern>
    </servlet-mapping>
    
    <!-- Google OAuth Callback -->
    <servlet>
        <servlet-name>GoogleCallbackServlet</servlet-name>
        <servlet-class>controller.GoogleCallbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleCallbackServlet</servlet-name>
        <url-pattern>/auth/google/callback</url-pattern>
    </servlet-mapping>
    
    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- Root Servlet -->
    <servlet>
        <servlet-name>RootServlet</servlet-name>
        <servlet-class>controller.RootServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RootServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
    
    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    
    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
        <url-pattern>/librarian/dashboard</url-pattern>
        <url-pattern>/user/dashboard</url-pattern>
    </servlet-mapping>
    
    <!-- Seller Dashboard Servlet -->
    <servlet>
        <servlet-name>SellerDashboardServlet</servlet-name>
        <servlet-class>controller.SellerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellerDashboardServlet</servlet-name>
        <url-pattern>/seller/dashboard</url-pattern>
    </servlet-mapping>
    
    <!-- Test Connection Servlet -->
    <servlet>
        <servlet-name>TestConnectionServlet</servlet-name>
        <servlet-class>controller.TestConnectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestConnectionServlet</servlet-name>
        <url-pattern>/test-connection</url-pattern>
    </servlet-mapping>
    
    <!-- Create Employee Accounts Servlet -->
    <servlet>
        <servlet-name>CreateEmployeeAccountsServlet</servlet-name>
        <servlet-class>controller.CreateEmployeeAccountsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateEmployeeAccountsServlet</servlet-name>
        <url-pattern>/create-employee-accounts</url-pattern>
    </servlet-mapping>
    
    <!-- Debug Login Servlet -->
    <servlet>
        <servlet-name>DebugLoginServlet</servlet-name>
        <servlet-class>controller.DebugLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DebugLoginServlet</servlet-name>
        <url-pattern>/debug-login</url-pattern>
    </servlet-mapping>

    <!-- App Servlet: các trang mock (mỗi URL một servlet-mapping riêng) -->
    <servlet>
        <servlet-name>AppServlet</servlet-name>
        <servlet-class>controller.AppServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/forgot-password</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/browse</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/my-library</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/edit-profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/change-password</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/linked-accounts</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/reading-history</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/bookmarks</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/reviews</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/notifications</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/cart</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/order-history</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/borrow-request</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/borrow-status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/borrowed-items</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/extend-request</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/reservation</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/fine-summary</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/pay-fine</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-readers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-employees</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-authors</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-categories</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-books</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-book-copies</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-borrow-requests</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-active-borrows</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-fine-types</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-fines</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-orders</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-payments</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppServlet</servlet-name>
        <url-pattern>/pages/admin-reviews</url-pattern>
    </servlet-mapping>

    <!-- Book Servlet -->
    <!-- Note: BookServlet uses @WebServlet annotation, no need for web.xml mapping -->
    <!-- Removing this mapping to avoid conflicts with JSP files in /books/ directory -->
    
    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>home.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
</web-app>
