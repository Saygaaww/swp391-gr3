    <!-- ============================================ -->
    <!-- FILTER: Character Encoding (UTF-8) - must run first -->
    <!-- ============================================ -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>controller.common.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================ -->
    <!-- FILTER: Authorization Filter                  -->
    <!-- ============================================ -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>controller.common.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
