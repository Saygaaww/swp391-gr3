<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Digital Library - SWP391</display-name>
    <description>Digital Library Management System - FPT University SWP391 Project</description>

    <!-- Context Parameters -->
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.localizationContext</param-name>
        <param-value>messages</param-value>
    </context-param>
    
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.locale</param-name>
        <param-value>vi_VN</param-value>
    </context-param>

    <!-- Default Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>books</welcome-file>
    </welcome-file-list>

    <!-- Servlet Definitions -->

    <!-- Auth Controller -->
    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>controller.AuthController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Profile Controller -->
    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>controller.ProfileController</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/profile/*</url-pattern>
    </servlet-mapping>

    <!-- Notification Controller -->
    <servlet>
        <servlet-name>NotificationController</servlet-name>
        <servlet-class>controller.NotificationController</servlet-class>
        <load-on-startup>3</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationController</servlet-name>
        <url-pattern>/notifications/*</url-pattern>
    </servlet-mapping>

    <!-- Admin Controller removed to use @WebServlet annotations inside controller.admin package -->
    <servlet-mapping>
        <servlet-name>NotificationController</servlet-name>
        <url-pattern>/notifications</url-pattern>
    </servlet-mapping>

    <!-- Book Controller -->
    <servlet>
        <servlet-name>BookController</servlet-name>
        <servlet-class>controller.BookController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>BookController</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>BookController</servlet-name>
        <url-pattern>/books/*</url-pattern>
    </servlet-mapping>

    <!-- Author Controller -->
    <servlet>
        <servlet-name>AuthorController</servlet-name>
        <servlet-class>controller.AuthorController</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AuthorController</servlet-name>
        <url-pattern>/authors</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AuthorController</servlet-name>
        <url-pattern>/authors/*</url-pattern>
    </servlet-mapping>

    <!-- Category Controller -->
    <servlet>
        <servlet-name>CategoryController</servlet-name>
        <servlet-class>controller.CategoryController</servlet-class>
        <load-on-startup>3</load-on-startup>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>CategoryController</servlet-name>
        <url-pattern>/categories</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>CategoryController</servlet-name>
        <url-pattern>/categories/*</url-pattern>
    </servlet-mapping>

    <!-- Customer Controller (Cart / Orders / My Library, etc.) -->
    <servlet>
        <servlet-name>CustomerController</servlet-name>
        <servlet-class>controller.CustomerController</servlet-class>
        <load-on-startup>4</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerController</servlet-name>
        <url-pattern>/customer</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerController</servlet-name>
        <url-pattern>/customer/*</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error/500.jsp</location>
    </error-page>
    
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/jsp/error/error.jsp</location>
    </error-page>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Security Constraints -->
    <security-constraint>
        <display-name>Protected Resources</display-name>
        <web-resource-collection>
            <web-resource-name>WEB-INF</web-resource-name>
            <url-pattern>/WEB-INF/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <!-- No roles, so no one can access -->
        </auth-constraint>
    </security-constraint>

    <!-- MIME Types -->
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>
    
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>
    
    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>

</web-app>